{
  "name": "tempo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "node scripts/ensure-prisma-client.mjs && prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test:ui": "node --test tests/ui-sdk.acceptance.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "db:push": "prisma db push",
    "strava:webhook": "node scripts/strava-webhook-subscribe.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:setup": "pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@garmin/fitsdk": "^21.221.0",
    "@prisma/client": "6.10.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@ui-sdk/core": "0.1.0-beta.6",
    "@ui-sdk/react": "0.1.0-beta.6",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.575.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bcryptjs": "^3.0.0",
