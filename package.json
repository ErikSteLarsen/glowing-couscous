{
  "name": "wattonaut",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test:ui": "node --test tests/ui-sdk.acceptance.mjs",
    "test": "prisma generate && node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "db:push": "prisma db push",
    "strava:webhook": "node scripts/strava-webhook-subscribe.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "test:db": "node --env-file-if-exists=.env scripts/test-database.mjs",
    "check:deadcode": "knip --include files,dependencies,unlisted,unresolved --treat-config-hints-as-errors",
    "typecheck": "prisma generate && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@garmin/fitsdk": "^21.221.0",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@ui-sdk/core": "0.1.0-beta.6",
    "@ui-sdk/react": "0.1.0-beta.6",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.575.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/busboy": "^1.5.5",
    "@types/node": "^25.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "knip": "6.45.1",
    "postcss": "^8.5.33",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402",
  "engines": {
    "node": ">=24"
  }
}
