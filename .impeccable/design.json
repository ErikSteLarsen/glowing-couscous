  "narrative": {
    "northStar": "Night Instrument",
    "overview": "Tempo is a Monday-first endurance training instrument on a dark ground. Hairline rules replace heavy cards, numbers are large and tabular, and one cyan trace marks the primary action, active state, focus, and now.",
    "keyCharacteristics": [
      "Dark only",
      "Hairline rules over heavy cards",
      "One cyan trace",
      "Tabular numbers with quiet units",
      "Collapsible icon-rail sidebar",
      "Hand-written SVG charts"
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Amber means worse than usual or needs attention; green means better or on plan. Neutral metrics show no signal color.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "A value is label, large tabular figure, quiet 0.5em unit, then optional detail. Use StatTile and the .data class.",
        "section": "typography"
      },
      {
        "name": "Tonal Depth",
        "body": "Depth is tonal layers and hairlines; outer shadow is reserved for hover lift on interactive tiles and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Reuse PageShell, TopBar, Surface, StatTile, Badge, EmptyState, SessionRow, and the shared button, switch, and field classes.",
      "Pair every color state with text, structure, or an accessible label.",
      "Preserve visible trace focus, reduced-motion behavior, explicit labels, AA contrast, and 44px mobile touch targets."
    ],
    "donts": [
      "Do not reintroduce a light theme or uppercase tracked labels.",
      "Do not make every region a floating card.",
      "Do not use color alone for state.",
      "Do not add gradients, charting libraries, or extra accent roles."
    ]
  }
