{
  "name": "tempo-ride",
  "productName": "Tempo Ride",
  "version": "0.2.0",
  "description": "Desktop companion for Tempo indoor bike workouts",
  "homepage": "https://github.com/ErikSteLarsen/glowing-couscous",
  "desktopName": "tempo-ride.desktop",
  "private": true,
  "main": "main.cjs",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "bash scripts/dist-linux.sh"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "app.tempo.ride",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "icon": "build/icon.png",
    "files": [
      "*.cjs",
      "ui/**",
      "build/icon.png"
    ],
    "protocols": [
      {
        "name": "Tempo Ride",
        "schemes": [
          "tempo-ride"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Tempo-Ride-Windows-Setup.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "artifactName": "Tempo-Ride-macOS-${arch}.dmg",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Tempo Ride connects to your trainer, heart-rate strap and cadence sensor during rides."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tempo-Ride-Linux.${ext}",
      "icon": "build/icons",
      "category": "Science;Sports",
      "syncDesktopName": true,
      "maintainer": "Erik Stensrud Larsen <ErikSteLarsen@users.noreply.github.com>"
    },
    "deb": {
      "afterInstall": "build/linux-after-install.sh"
    }
  }
}
