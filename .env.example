# Neon pooled connection string used by the application at runtime.
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection string used by Prisma migrations and schema commands.
DIRECT_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Optional AI-authored workouts in the guided creator. Without a key, Wattonaut
# still builds a validated workout from the same choices and recent history.
# Keep the key server-only. Recent history sent to the model is aggregate counts,
# durations, and RPE timing; no activity notes or raw telemetry are sent.
# OPENAI_API_KEY=""
# OPENAI_WORKOUT_MODEL="gpt-4o-mini"
# For a custom OpenAI-compatible endpoint, set the full API URL, its protocol,
# API key, and model. "responses" uses /v1/responses with JSON Schema output;
# "chat-completions" uses /v1/chat/completions with JSON mode. Full model
# workouts are validated before use; invalid responses use the standard draft.
# A custom URL requires WORKOUT_LLM_API_KEY; the OpenAI key is never forwarded.
# HTTPS is required in production. A custom provider may retain data under its
# own policy.
# WORKOUT_LLM_API_URL="https://your-provider.example/v1/chat/completions"
# WORKOUT_LLM_API_FORMAT="chat-completions"
# WORKOUT_LLM_API_KEY=""
# WORKOUT_LLM_MODEL="your-model-id"

# Optional credential-account recovery. Verify this sender domain in Resend before production.
# RESEND_API_KEY="re_..."
# PASSWORD_RESET_FROM_EMAIL="Wattonaut <accounts@your-verified-domain.example>"

# Strava API app (register at https://www.strava.com/settings/api).
# Keep the client secret and token encryption key server-only.
# STRAVA_CLIENT_ID=""
# STRAVA_CLIENT_SECRET=""
# STRAVA_TOKEN_ENCRYPTION_KEY="64-hex-characters-from-a-cryptographically-random-32-byte-key"
# STRAVA_WEBHOOK_VERIFY_TOKEN="a-long-random-value-used-only-for-webhook-validation"
# STRAVA_WEBHOOK_CALLBACK_URL="https://your-public-domain.example/api/strava/webhook"
# Set this after creating the one app-wide Strava webhook subscription.
# STRAVA_WEBHOOK_SUBSCRIPTION_ID=""
# Optional recovery endpoint secret for retrying events left in the durable queue.
# STRAVA_WEBHOOK_WORKER_SECRET=""
# STRAVA_OAUTH_REDIRECT_URI="https://your-public-domain.example/api/strava/callback"

# Optional scheduled GET/POST /api/activity-analysis/worker, Authorization: Bearer <secret>.
# ACTIVITY_ANALYSIS_WORKER_SECRET=""

# Optional Google OAuth. Auth.js v5 reads these names automatically.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Optional download page for the Wattonaut Ride desktop app (trainer rides over Bluetooth).
# Shown next to "Open in Wattonaut Ride app" on bike sessions; the link is hidden when unset.
# NEXT_PUBLIC_TEMPO_RIDE_DOWNLOAD_URL="https://github.com/your-org/tempo/releases/latest"

# Optional: play YouTube videos inside Wattonaut, beside the ride stats. Riders
# browse YouTube itself (their own account) and bring a video to the ride;
# YouTube's policies require checking every embedded video's made-for-kids
# status first, which needs this key. Without it videos open on YouTube instead.
# Create the key in Google Cloud Console: enable "YouTube Data API v3", then
# Credentials -> Create credentials -> API key, restricted to that API. Keep it
# server-only (never NEXT_PUBLIC_). Each new video costs 1 unit of the default
# 10,000 units a day (reset at midnight Pacific time); checks are cached for an
# hour per server process. Wattonaut makes no search calls, so no search quota.
# YOUTUBE_API_KEY=""
